# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db
DB_USER=postgres
DB_PASSWORD=your_password
# Render/Postgres URL (takes priority if present)
# DATABASE_URL=postgres://user:password@host:5432/chat_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Server Configuration
PORT=3000
NODE_ENV=development
AUTH_SECRET=change_this_secret

# Client Configuration
CLIENT_URL=http://localhost:5173
# Optional comma-separated extra origins
CORS_ORIGINS=http://localhost:5174
# En desarrollo se crea una URL HTTPS temporal con cloudflared.
AUTO_DEV_TUNNEL=true
# En producción usa el dominio público permanente del backend.
# PUBLIC_API_URL=https://api.tu-chat.com
# Allow any *.vercel.app preview deployment
ALLOW_VERCEL_PREVIEWS=false

# WhatsApp Cloud API
# Dedicated encryption secret for per-company WhatsApp credentials.
WHATSAPP_CREDENTIALS_KEY=replace_with_a_long_random_secret

# Gemini AI (free tier)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: FFmpeg path for audio transcoding (WhatsApp voice notes)
# Example (winget): C:\Users\Luis tapia\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.0.1-full_build\bin\ffmpeg.exe
FFMPEG_PATH=

# Password recovery: public FRONTEND origin, never the WhatsApp webhook URL.
PASSWORD_RESET_URL=http://localhost:5174
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
